#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Extract layout-preserving text from one or more PDFs."""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
from pathlib import Path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Extract text from resume PDFs.")
    parser.add_argument("pdf", nargs="+", type=Path)
    parser.add_argument(
        "--output-dir",
        type=Path,
        help="Write one .txt file per PDF instead of printing to stdout",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if shutil.which("pdftotext") is None:
        print(
            "pdftotext is required; install Poppler utilities",
            file=sys.stderr,
        )
        return 1
    if len(args.pdf) > 1 and args.output_dir is None:
        print("--output-dir is required for multiple PDFs", file=sys.stderr)
        return 1

    if args.output_dir:
        args.output_dir.mkdir(parents=True, exist_ok=True)

    for pdf in args.pdf:
        if not pdf.is_file():
            print(f"PDF not found: {pdf}", file=sys.stderr)
            return 1
        result = subprocess.run(
            ["pdftotext", "-layout", str(pdf.resolve()), "-"],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if result.returncode != 0:
            print(result.stderr.strip(), file=sys.stderr)
            return result.returncode
        if args.output_dir:
            destination = args.output_dir / f"{pdf.stem}.txt"
            destination.write_text(result.stdout, encoding="utf-8")
            print(f"wrote: {destination}")
        else:
            print(result.stdout, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
