#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Validate PDFs produced by the resume build."""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path


LOG_FAILURES = (
    re.compile(r"Overfull"),
    re.compile(r"Underfull"),
    re.compile(r"Missing character"),
    re.compile(r"LaTeX Font Warning"),
    re.compile(r"Package .* Warning"),
    re.compile(r"^!", re.MULTILINE),
)
BAD_TEXT_GLYPHS = ("\ufffd", "\u25a0", "\u25a1")
TOP_BOTTOM_MARGIN_PT = 32.6  # cv.cls geometry uses 1.15cm top/bottom margins


class ValidationError(RuntimeError):
    """Raised when a generated PDF fails a quality check."""


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        raise ValidationError(
            f"required command not found: {name}; install Poppler utilities"
        )


def run(command: list[str]) -> str:
    result = subprocess.run(
        command,
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise ValidationError(f"{' '.join(command)} failed: {detail}")
    return result.stdout


def parse_pdfinfo(output: str) -> dict[str, str]:
    result: dict[str, str] = {}
    for line in output.splitlines():
        key, separator, value = line.partition(":")
        if separator:
            result[key.strip()] = value.strip()
    return result


def compute_page_fills(pdf: Path) -> list[float]:
    """Return the fraction of the usable text area covered on each page."""
    output = run(["pdftotext", "-bbox", str(pdf), "-"])
    pages: list[dict[str, float]] = []
    current: dict[str, float] | None = None
    for line in output.splitlines():
        page_match = re.search(
            r'<page width="([0-9.]+)" height="([0-9.]+)">', line
        )
        if page_match:
            current = {"height": float(page_match.group(2)), "max_y": 0.0}
            pages.append(current)
            continue
        y_match = re.search(r'yMax="([0-9.]+)"', line)
        if y_match is not None and current is not None:
            current["max_y"] = max(current["max_y"], float(y_match.group(1)))

    fills: list[float] = []
    for page in pages:
        usable = page["height"] - 2 * TOP_BOTTOM_MARGIN_PT
        if usable <= 0:
            fills.append(0.0)
            continue
        fills.append(
            max(0.0, min(1.0, (page["max_y"] - TOP_BOTTOM_MARGIN_PT) / usable))
        )
    return fills


def validate_fonts(pdf: Path) -> int:
    output = run(["pdffonts", str(pdf)])
    lines = output.splitlines()
    separator_index = next(
        (index for index, line in enumerate(lines) if line.startswith("---")),
        None,
    )
    if separator_index is None:
        raise ValidationError(f"{pdf}: cannot parse pdffonts output")
    font_lines = [line for line in lines[separator_index + 1 :] if line.strip()]
    if not font_lines:
        raise ValidationError(f"{pdf}: no fonts found")
    for line in font_lines:
        parts = line.split()
        if len(parts) < 6 or parts[-5] != "yes":
            raise ValidationError(f"{pdf}: font is not embedded: {line}")
    return len(font_lines)


def validate_log(pdf: Path, log_dir: Path | None) -> None:
    directory = log_dir if log_dir is not None else pdf.parent
    log = directory / f"{pdf.stem}.log"
    if not log.exists():
        raise ValidationError(f"{pdf}: expected LaTeX log not found: {log}")
    content = log.read_text(encoding="utf-8", errors="replace")
    matches = [
        pattern.pattern for pattern in LOG_FAILURES if pattern.search(content)
    ]
    if matches:
        raise ValidationError(
            f"{pdf}: LaTeX log contains rejected diagnostics: "
            + ", ".join(matches)
        )


def validate_pdf(
    pdf: Path,
    expected_pages: int,
    log_dir: Path | None,
) -> tuple[list[str], list[str]]:
    if not pdf.is_file() or pdf.stat().st_size == 0:
        raise ValidationError(f"{pdf}: PDF is missing or empty")

    info = parse_pdfinfo(run(["pdfinfo", str(pdf)]))
    try:
        pages = int(info.get("Pages", ""))
    except ValueError as exc:
        raise ValidationError(f"{pdf}: invalid page count") from exc
    if pages != expected_pages:
        raise ValidationError(
            f"{pdf}: expected {expected_pages} page(s), found {pages}"
        )

    page_size = info.get("Page size", "")
    size_match = re.search(
        r"([0-9.]+) x ([0-9.]+) pts(?: \(A4\))?", page_size
    )
    if not size_match:
        raise ValidationError(f"{pdf}: cannot parse page size: {page_size}")
    width, height = (float(value) for value in size_match.groups())
    if abs(width - 595.28) > 1 or abs(height - 841.89) > 1:
        raise ValidationError(f"{pdf}: expected portrait A4, found {page_size}")

    author = info.get("Author", "").strip()
    title = info.get("Title", "").strip()
    if not author or not title:
        raise ValidationError(f"{pdf}: Author and Title metadata are required")

    font_count = validate_fonts(pdf)
    validate_log(pdf, log_dir)

    text = run(["pdftotext", "-layout", str(pdf), "-"])
    if len(text.strip()) < 20:
        raise ValidationError(f"{pdf}: extracted text is unexpectedly empty")
    bad = [glyph for glyph in BAD_TEXT_GLYPHS if glyph in text]
    if bad:
        raise ValidationError(f"{pdf}: extracted text contains broken glyphs")

    fills = compute_page_fills(pdf)
    fill_text = ", ".join(f"{round(fill * 100)}%" for fill in fills)
    warnings: list[str] = []
    if fills:
        last_fill = fills[-1]
        if last_fill > 0.96:
            warnings.append(
                f"{pdf}: last page is {round(last_fill * 100)}% full; "
                "consider layout.preset compact or trimming content"
            )
        elif last_fill < 0.70:
            warnings.append(
                f"{pdf}: last page is {round(last_fill * 100)}% full; "
                "consider layout.preset airy or adding content"
            )

    details = [
        f"pages={pages}",
        "size=A4",
        f"fonts={font_count} embedded",
        f"author={author}",
        f"title={title}",
        f"text_chars={len(text.strip())}",
        f"fill={fill_text}",
    ]
    return details, warnings


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Validate generated resume PDFs.")
    parser.add_argument("pdf", nargs="+", type=Path, help="PDF file to validate")
    parser.add_argument(
        "--expected-pages",
        type=int,
        default=1,
        help="Required number of pages",
    )
    parser.add_argument(
        "--log-dir",
        type=Path,
        help="Directory containing matching LaTeX .log files",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        for command in ("pdfinfo", "pdffonts", "pdftotext"):
            require_command(command)
        for pdf in args.pdf:
            details, warnings = validate_pdf(
                pdf.resolve(),
                args.expected_pages,
                args.log_dir.resolve() if args.log_dir else None,
            )
            print(f"ok: {pdf}")
            for detail in details:
                print(f"  {detail}")
            for warning in warnings:
                print(f"  note: {warning}")
    except ValidationError as exc:
        print(f"validation failed: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
