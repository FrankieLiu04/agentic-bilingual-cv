# User-provided source material
input/*
!input/README.md
!input/.gitkeep

# Private structured resume data
data/private/*
!data/private/README.md
!data/private/.gitkeep

# Generated resumes and intermediate build files
output/*
!output/README.md
!output/.gitkeep
build/
tmp/

# Machine-local agent instructions and environment
CLAUDE.local.md
.env
.env.*
!.env.example

# Editor and operating-system files
.DS_Store
*.swp
*.swo
*~

# Python caches
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# LaTeX intermediate files outside build/
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
